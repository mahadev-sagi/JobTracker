# =============================================================================
# JobTracker — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/jobtracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jobtracker

# -----------------------------------------------------------------------------
# LLM (any OpenAI-compatible endpoint)
# -----------------------------------------------------------------------------
# Defaults target Google Gemini, whose free tier is ample for this workload.
# Get a key at https://aistudio.google.com - no credit card required.
# To use OpenAI instead: clear LLM_BASE_URL and set LLM_MODEL=gpt-4o.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.1-flash-lite

# Legacy aliases, still honoured when the LLM_* equivalents are unset.
OPENAI_API_KEY=
OPENAI_MODEL=

# -----------------------------------------------------------------------------
# Gmail / Google Cloud
# -----------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_PUBSUB_TOPIC=gmail-notifications
GOOGLE_PUBSUB_SUBSCRIPTION=gmail-notifications-sub
GMAIL_USER_EMAIL=you@gmail.com
# Path INSIDE the container to the token.json produced by
# backend/scripts/bootstrap_gmail_token.py. Mount ./backend/secrets to supply it.
GOOGLE_CREDENTIALS_JSON=/app/secrets/token.json

# -----------------------------------------------------------------------------
# AWS (for Lambda deployment)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# GitHub Listings Source
# -----------------------------------------------------------------------------
LISTINGS_URL=https://raw.githubusercontent.com/SimplifyJobs/Summer2025-Internships/dev/.github/scripts/listings.json

# -----------------------------------------------------------------------------
# Local overrides
# -----------------------------------------------------------------------------
# Host port for the dockerised Postgres. Change if 5432 is already in use by a
# locally installed PostgreSQL server.
POSTGRES_HOST_PORT=5432

# -----------------------------------------------------------------------------
# Pub/Sub push authentication
# -----------------------------------------------------------------------------
# Preferred: configure the push subscription with an OIDC token and set the
# audience you gave it. The webhook then verifies a Google-signed JWT.
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT_EMAIL=
# Fallback for local development only; ignored when PUBSUB_AUDIENCE is set.
PUBSUB_VERIFICATION_TOKEN=
