# =============================================================================
# JobTracker — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/jobtracker
POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jobtracker

# -----------------------------------------------------------------------------
# LLM (any OpenAI-compatible endpoint)
# -----------------------------------------------------------------------------
# Defaults target Google Gemini, whose free tier is ample for this workload.
# Get a key at https://aistudio.google.com - no credit card required.
# To use OpenAI instead: clear LLM_BASE_URL and set LLM_MODEL=gpt-4o.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.1-flash-lite

# Legacy aliases, still honoured when the LLM_* equivalents are unset.
OPENAI_API_KEY=
OPENAI_MODEL=

# -----------------------------------------------------------------------------
# Gmail / Google Cloud
# -----------------------------------------------------------------------------
# Leave GOOGLE_CLOUD_PROJECT_ID empty to run without Gmail push notifications.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_PUBSUB_TOPIC=gmail-notifications

# OAuth client of type "Web application". Used for sign-in and for each
# user's Gmail connection. Authorised redirect URIs must include
# {PUBLIC_URL}/api/auth/callback and {PUBLIC_URL}/api/gmail/callback.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Encrypts stored Gmail refresh tokens. Generate once and keep it safe:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing it forces every user to reconnect Gmail.
TOKEN_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Access
# -----------------------------------------------------------------------------
# Comma-separated invite list. Admins are always allowed and can run the
# scraper. With both empty, anyone may sign in (development) or no one may
# (production).
ALLOWED_EMAILS=
ADMIN_EMAILS=
SESSION_TTL_DAYS=30
# Development only: sign in as any address without Google.
DEV_LOGIN_ENABLED=false

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# The address users open, without a trailing slash. https:// makes cookies
# Secure.
PUBLIC_URL=http://localhost:5173
ENVIRONMENT=development
LOG_LEVEL=INFO
# Background jobs: Gmail watch renewal, and scraping every N hours (0 = off).
SCHEDULER_ENABLED=true
SCRAPER_INTERVAL_HOURS=24

# -----------------------------------------------------------------------------
# GitHub Listings Source
# -----------------------------------------------------------------------------
LISTINGS_URL=https://raw.githubusercontent.com/SimplifyJobs/Summer2025-Internships/dev/.github/scripts/listings.json

# -----------------------------------------------------------------------------
# Local overrides
# -----------------------------------------------------------------------------
# Host port for the dockerised Postgres. Change if 5432 is already in use by a
# locally installed PostgreSQL server.
POSTGRES_HOST_PORT=5432

# -----------------------------------------------------------------------------
# Pub/Sub push authentication
# -----------------------------------------------------------------------------
# Preferred: configure the push subscription with an OIDC token and set the
# audience you gave it. The webhook then verifies a Google-signed JWT.
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT_EMAIL=
# Fallback for local development only; ignored when PUBSUB_AUDIENCE is set.
PUBSUB_VERIFICATION_TOKEN=
