# =============================================================================
# JobTracker production settings. Lives on the server as infra/deploy/.env.
# bootstrap.sh copies this file and fills in the generated secrets; edit the
# rest by hand, then run: docker compose up -d
# Never commit the real file.
# =============================================================================

# ── Address ──────────────────────────────────────────────────────────────────
# Public hostname, no scheme. With DuckDNS: <name>.duckdns.org
DOMAIN=
# Required. Let's Encrypt sends certificate problems here (your own address).
ACME_EMAIL=

# DuckDNS keeps DOMAIN pointed at this server's IP (duckdns.sh, every 5 min).
# Leave empty if DNS is managed some other way.
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=

# ── Images ───────────────────────────────────────────────────────────────────
GITHUB_OWNER=mahadev-sagi
IMAGE_TAG=latest
# Branch update.sh follows for the compose file, Caddyfile and scripts.
DEPLOY_BRANCH=main

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=jobtracker
POSTGRES_DB=jobtracker
POSTGRES_PASSWORD=__GENERATED__

# ── Access ───────────────────────────────────────────────────────────────────
# Comma-separated Google account addresses. Admins are always allowed.
ADMIN_EMAILS=
ALLOWED_EMAILS=

# ── Google (see README "Google setup") ───────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_PUBSUB_TOPIC=gmail-notifications
PUBSUB_AUDIENCE=
PUBSUB_SERVICE_ACCOUNT_EMAIL=
# Encrypts stored Gmail refresh tokens. Back this up with the database
# backups: without it they cannot be read and everyone must reconnect Gmail.
TOKEN_ENCRYPTION_KEY=__GENERATED__

# ── Email classifier (any OpenAI-compatible endpoint) ────────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.1-flash-lite

# ── Scraper ──────────────────────────────────────────────────────────────────
LISTINGS_URL=https://raw.githubusercontent.com/SimplifyJobs/Summer2025-Internships/dev/.github/scripts/listings.json
SCRAPER_INTERVAL_HOURS=24

# ── Backups (backup.sh) ──────────────────────────────────────────────────────
BACKUP_DIR=/var/backups/jobtracker
BACKUP_KEEP=14
# Optional off-server copy, e.g. s3://my-bucket/jobtracker. Needs the AWS CLI
# and an instance role allowed to write there.
BACKUP_S3_URI=

LOG_LEVEL=INFO
